DB_URL=jdbc:postgresql://<host>:<port>/postgres?prepareThreshold=0
DB_USER=<user>
DB_PASSWORD=<password>

# Migraciones Flyway (opcional):
# - FLYWAY_ENABLED=true por defecto.
# - Si DB_URL usa Transaction Pooler de Supabase (:6543), la app deriva automáticamente
#   FLYWAY_DB_URL con el puerto :5432 (Session Pooler), requerido por Flyway para locks de sesión.
#   Solo define FLYWAY_DB_URL si necesitas apuntar manualmente a otro host/puerto para migrar.
# FLYWAY_ENABLED=true
# FLYWAY_DB_URL=jdbc:postgresql://<host>:5432/postgres?prepareThreshold=0

JWT_SECRET=<secret_key_minimum_256_bits>
JWT_EXPIRATION_MS=86400000

# Configuración de Cookie de Autenticación:
# En entorno local (HTTP): COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# En producción (HTTPS): COOKIE_SECURE=true, COOKIE_SAME_SITE=Lax (o None si están en dominios diferentes con HTTPS)
COOKIE_NAME=jwt_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/

CORS_ALLOWED_ORIGINS=http://localhost:5173

SWAGGER_ENABLED=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
MAIL_FROM=tu_correo@gmail.com

