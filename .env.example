DB_URL=jdbc:postgresql://<host>:<port>/postgres?prepareThreshold=0
DB_USER=<user>
DB_PASSWORD=<password>

JWT_SECRET=<secret_key_minimum_256_bits>
JWT_EXPIRATION_MS=86400000

# Configuración de Cookie de Autenticación:
# En entorno local (HTTP): COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# En producción (HTTPS): COOKIE_SECURE=true, COOKIE_SAME_SITE=Lax (o None si están en dominios diferentes con HTTPS)
COOKIE_NAME=jwt_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/

CORS_ALLOWED_ORIGINS=http://localhost:5173

SWAGGER_ENABLED=true
